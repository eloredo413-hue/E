-- PLAYERS PAGE BUTTONS
--
-- The report flags next to "Add Friend" on the Players tab do
-- nothing when tapped. Driving the legacy Report tab by firing its
-- button handlers left pages stuck on top of each other and the
-- player was never selected, so a flag now opens its own 2017-style
-- report dialog and never touches the legacy menu.
--
-- "Add Friend" falls back to the friend request prompt when the
-- legacy button didn't send a request.

task.spawn(function()

	local Hooked = setmetatable({}, { __mode = "k" })

	local LocalPlayer = Players.LocalPlayer

	local AbuseTypes = {
		"Swearing",
		"Inappropriate Username",
		"Bullying",
		"Scamming",
		"Dating",
		"Cheating/Exploiting",
		"Personal Question",
		"Offsite Links",
	}

	local ButtonColor = Color3.fromRGB(77, 82, 95)

	local GetText = function(Object: Instance)

		if Object:IsA("TextLabel") or Object:IsA("TextButton") then
			return Object.Text
		end

		return nil

	end

	local HasText = function(Object: Instance, Text: string)

		if GetText(Object) == Text then
			return true
		end

		for _, Descendant in ipairs(Object:GetDescendants()) do

			if GetText(Descendant) == Text then
				return true
			end

		end

		return false

	end

	local Notify = function(Text: string)

		pcall(function()
			StarterGui:SetCore("SendNotification", {
				Title = "Report",
				Text = Text,
				Duration = 5
			})
		end)

	end

	-- Player rows show the player's name (or display name)
	-- somewhere inside the row frame. Only look two levels up so
	-- buttons on other pages are never mistaken for a player row.

	local FindRowPlayer = function(Button: GuiButton)

		local Row = Button.Parent

		for _ = 1, 2 do

			if not Row or Row == LegacyGui then
				return nil
			end

			for _, Player in ipairs(Players:GetPlayers()) do

				if
					Row.Name:find(Player.Name, 1, true)
					or HasText(Row, Player.Name)
					or HasText(Row, Player.DisplayName)
					or HasText(Row, "@" .. Player.Name)
				then
					return Player
				end

			end

			Row = Row.Parent

		end

		return nil

	end

	-- The flag is the only icon-only button in a player row.

	local IsFlag = function(Object: GuiButton)

		if Object.Name:lower():find("tab") then
			return false
		end

		if Object:IsA("TextButton") and Object.Text ~= "" then
			return false
		end

		for _, Descendant in ipairs(Object:GetDescendants()) do

			local Text = GetText(Descendant)

			if Text and Text ~= "" then
				return false
			end

		end

		return Object.Name:lower():find("report") ~= nil
			or Object:IsA("ImageButton")
			or Object:FindFirstChildWhichIsA("ImageLabel") ~= nil

	end

	-- Report dialog

	local Dialog = nil

	local DialogPlayer = nil

	local CloseDialog = function()

		if Dialog then
			Dialog:Destroy()
		end

		Dialog = nil

		DialogPlayer = nil

	end

	local MakeLabel = function(Text: string, Properties: Properties, Parent: Instance)

		local Label = Create("TextLabel", {
			BackgroundTransparency = 1,
			Font = Enum.Font.SourceSansBold,
			Text = Text,
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, false, Parent)

		Set(Label, Properties)

		return Label

	end

	local MakeButton = function(Text: string, Properties: Properties, Parent: Instance)

		local Button = Create("TextButton", {
			AutoButtonColor = true,
			BackgroundColor3 = ButtonColor,
			BorderSizePixel = 0,
			Font = Enum.Font.SourceSansBold,
			Text = Text,
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 22,
		}, false, Parent)

		Create("UICorner", { CornerRadius = UDim.new(0, 4) }, false, Button)

		Set(Button, Properties)

		return Button

	end

	local OpenDialog = function(Player: Player)

		CloseDialog()

		-- Draw above the legacy menu.

		local Root =
			LegacyGui:IsA("LayerCollector") and LegacyGui
			or LegacyGui:FindFirstAncestorWhichIsA("LayerCollector")

		local Gui = Create("ScreenGui", {
			Name = "LegacyReportDialog",
			DisplayOrder = ((Root and Root:IsA("ScreenGui")) and Root.DisplayOrder or 0) + 100,
			IgnoreGuiInset = true,
			ResetOnSpawn = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		})

		Dialog = Gui

		DialogPlayer = Player

		-- Keeps taps from reaching the menu underneath.

		Create("TextButton", {
			Name = "Shield",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.5,
			BorderSizePixel = 0,
			Modal = true,
			Size = UDim2.fromScale(1, 1),
			Text = "",
		}, false, Gui)

		local Window = Create("Frame", {
			Name = "Window",
			Active = true,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.fromRGB(30, 30, 30),
			BackgroundTransparency = 0.1,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0.9, 0, 0, 250),
		}, false, Gui)

		Create("UICorner", { CornerRadius = UDim.new(0, 6) }, false, Window)

		Create("UISizeConstraint", { MaxSize = Vector2.new(460, 250) }, false, Window)

		MakeLabel(`Report {Player.Name}`, {
			Position = UDim2.new(0, 16, 0, 10),
			Size = UDim2.new(1, -32, 0, 30),
			TextSize = 26,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Center,
		}, Window)

		-- Type Of Abuse

		MakeLabel("Type Of Abuse", {
			Position = UDim2.new(0, 16, 0, 56),
			Size = UDim2.new(0.4, -24, 0, 36),
		}, Window)

		local Left = MakeButton("<", {
			Position = UDim2.new(0.4, 0, 0, 56),
			Size = UDim2.new(0, 36, 0, 36),
		}, Window)

		local Choice = MakeLabel("Choose One", {
			Position = UDim2.new(0.4, 40, 0, 56),
			Size = UDim2.new(0.6, -96, 0, 36),
			TextSize = 20,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Center,
		}, Window)

		local Right = MakeButton(">", {
			Position = UDim2.new(1, -52, 0, 56),
			Size = UDim2.new(0, 36, 0, 36),
		}, Window)

		-- Abuse Description

		MakeLabel("Abuse Description", {
			Position = UDim2.new(0, 16, 0, 106),
			Size = UDim2.new(0.4, -24, 0, 36),
		}, Window)

		local Description = Create("TextBox", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.85,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			ClipsDescendants = true,
			Font = Enum.Font.SourceSans,
			PlaceholderColor3 = Color3.fromRGB(178, 178, 178),
			PlaceholderText = "(Optional)",
			Position = UDim2.new(0.4, 0, 0, 106),
			Size = UDim2.new(0.6, -16, 0, 36),
			Text = "",
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 20,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, false, Window)

		Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, false, Description)

		-- Cancel / Submit

		local Cancel = MakeButton("Cancel", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 16, 1, -16),
			Size = UDim2.new(0.5, -24, 0, 40),
		}, Window)

		local Submit = MakeButton("Submit", {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -16, 1, -16),
			Size = UDim2.new(0.5, -24, 0, 40),
		}, Window)

		local Index = 0

		local Refresh = function()

			Choice.Text = AbuseTypes[Index] or "Choose One"

			Submit.AutoButtonColor = Index > 0

			Submit.TextTransparency = (Index > 0) and 0 or 0.5

		end

		Refresh()

		Left.Activated:Connect(function()

			Index -= 1

			if Index < 1 then
				Index = #AbuseTypes
			end

			Refresh()

		end)

		Right.Activated:Connect(function()

			Index = Index % #AbuseTypes + 1

			Refresh()

		end)

		Cancel.Activated:Connect(CloseDialog)

		Submit.Activated:Connect(function()

			if Index == 0 or Dialog ~= Gui then
				return
			end

			local Reason = AbuseTypes[Index]

			local Message = Description.Text

			CloseDialog()

			local Success, Result = pcall(function()
				Players:ReportAbuse(Player, Reason, Message)
			end)

			if Success then

				Notify("Thanks for your report! Our moderators will review the chat logs and evaluate what happened.")

			else

				warn(`Report failed | {Result}`)

				Notify("Your report couldn't be sent.")

			end

		end)

		Gui.Parent = (Root and Root.Parent) or CoreGui

	end

	Players.PlayerRemoving:Connect(function(Player)

		if Player == DialogPlayer then
			CloseDialog()
		end

	end)

	-- Add Friend fallback

	local SendFriendRequest = function(Button: GuiButton, Player: Player)

		-- Give the legacy handler a chance first; it relabels the
		-- button once the request goes out.

		task.wait(1)

		if not HasText(Button, "Add Friend") or Player.Parent ~= Players then
			return
		end

		local Success = pcall(function()
			LocalPlayer:RequestFriendship(Player)
		end)

		if not Success then

			pcall(function()
				StarterGui:SetCore("PromptSendFriendRequest", Player)
			end)

		end

	end

	local Hook = function(Object: Instance)

		if Hooked[Object] or not Object:IsA("GuiButton") then
			return
		end

		-- Buttons and rows can be filled in after they are parented.

		task.defer(function()

			if Hooked[Object] or not (IsFlag(Object) or HasText(Object, "Add Friend")) then
				return
			end

			for _ = 1, 10 do

				if Hooked[Object] or not Object.Parent or FindRowPlayer(Object) then
					break
				end

				task.wait(0.1)

			end

			if Hooked[Object] or not FindRowPlayer(Object) then
				return
			end

			local Flag = IsFlag(Object)

			if not Flag and not HasText(Object, "Add Friend") then
				return
			end

			Hooked[Object] = true

			Object.Activated:Connect(function()

				local Player = FindRowPlayer(Object)

				if not Player or Player.Parent ~= Players or Player == LocalPlayer then
					return
				end

				if Flag then
					OpenDialog(Player)
				else
					SendFriendRequest(Object, Player)
				end

			end)

		end)

	end

	for _, Object in ipairs(LegacyGui:GetDescendants()) do
		Hook(Object)
	end

	LegacyGui.DescendantAdded:Connect(Hook)

end)
